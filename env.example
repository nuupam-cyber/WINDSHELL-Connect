# คัดลอกเป็น .env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env)
DATABASE_URL=postgres://user:password@host:5432/dbname
SESSION_SECRET=สตริงสุ่มยาวอย่างน้อย 32 ตัวอักษร
# ไม่บังคับ
# REF_SECRET=สตริงสุ่มสำหรับสร้างเลขอ้างอิงคำขอ
# UPLOAD_DIR=uploads
# MAX_FILE_SIZE=5242880
# SEED_PASSWORD=รหัสผ่านบัญชีทดสอบ (อย่างน้อย 8 ตัว)
# NODE_ENV=production
